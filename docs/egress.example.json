{
  "comment": "Copy, replace the corp.example hosts with your own, and point COGNEE_EGRESS_POLICY at the copy. See docs/egress.md.",
  "mode": "enforce",
  "log": "egress.jsonl",
  "runtime": {
    "hosts": [
      {"host": "llm.corp.example", "ports": [443], "role": "llm"},
      {"host": "embeddings.corp.example", "ports": [443], "role": "embedding"},
      {"host": "decider.corp.example", "ports": [443], "role": "decider"},
      {"host": "artifactory.corp.example", "ports": [443], "role": "download", "download_only": true}
    ],
    "subprocesses": [],
    "listen": "loopback"
  },
  "install": {
    "hosts": [
      {"host": "artifactory.corp.example", "ports": [443], "role": "download"},
      {"host": "gitlab.corp.example", "ports": [443], "role": "download"},
      {"host": "extension.ladybugdb.com", "ports": [80, 443], "role": "download"}
    ],
    "subprocesses": ["git", "uv", "c++", "cmake", "ninja"]
  }
}
